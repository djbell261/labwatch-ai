# Copy to .env and fill in. Never commit .env.
# Loaded automatically if python-dotenv is installed; otherwise export these in your shell.

# Which investigator the live server uses: baseline | muse | open | replay:<path>
LABWATCH_CLIENT=baseline

# Muse Spark via the Meta Model API (OpenAI-compatible chat completions)
META_API_KEY=
# Base URL ending before /chat/completions, from the Meta Model API docs
META_BASE_URL=
# The Muse Spark model id from the Meta Model API docs
META_MODEL=

# Private mode: Muse Spark Open or Muse Glimmer on Baseten/Modal
OPEN_WEIGHTS_BASE_URL=
# Optional; leave blank if the endpoint has no auth
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=
